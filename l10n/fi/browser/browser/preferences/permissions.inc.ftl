permissions-site-webgl-window2 =
    .title = Asetukset - WebGL-oikeudet
    .style = { permissions-window2.style }
permissions-site-webgl-desc = Seuraavat verkkosivustot ovat pyytäneet luvan saada luoda WebGL-konteksti. Voit määrittää, mitkä sivustot saavat luoda WebGL-kontekstin. Voit myös estää pyynnöt kysyä lupaa käyttää WebGL-kontekstia.
permissions-site-eme-window2 =
    .title = Asetukset - EME-oikeudet
    .style = { permissions-window2.style }
permissions-site-jit-window2 =
    .title = Asetukset - JavaScriptin JIT-oikeudet
    .style = { permissions-window2.style }
permissions-site-eme-desc = Seuraavat sivustot ovat pyytäneet DRM-suojatun sisällön toistamista. Voit määrittää, mitkä sivustot saavat toistaa DRM-suojattua sisältöä. Voit myös estää DRM-suojatun sisällön toistamiseen liittyvät uudet pyynnöt.
permissions-site-eme-disable-label =
    .label = Estä uudet pyynnöt, jotka kysyvät lupaa toistaa DRM-suojattua sisältöä
permissions-site-eme-disable-desc = Tämä estää kaikkia sivustoja, joita ei ole listattu yllä, pyytämästä oikeutta toistaa DRM-suojattua sisältöä.
permissions-site-canvas-window2 =
    .title = Asetukset - Kankaan purkamisen oikeudet
    .style = { permissions-window2.style }
permissions-site-canvas-desc = Seuraavat sivustot ovat pyytäneet kangasdatan purkamista Voit määrittää, mitkä sivustot saavat purkaa kangasdataa Voit myös estää kangasdatan purkamiseen liittyvät uudet pyynnöt.
permissions-site-jit-desc = Seuraavilla sivustoilla on oikeus JavaScriptin JIT-suoritukseen. JavaScriptin JIT-suorituksen poistaminen käytöstä voi parantaa turvallisuutta vähentämällä altistusta koodin suoritukseen tähtääviin hyökkäyksiin, mutta se voi hidastaa sivustoja ja sovelluksia. WebAssembly ei toimi, jos JIT on poistettu käytöstä.
